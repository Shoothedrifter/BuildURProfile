# Private Python Agent sample. Copy to repository-root .env.agent for the
# development launcher or compose.agent.yml. Merge into existing files.
# Direct Python startup only reads process environment variables, not env files.
# Service token and API URL are supplied by the launcher/Compose.
# Compose injects the checkpoint connection. Set it here for local development.
AGENT_CHECKPOINT_DATABASE_URL=
AGENT_CHECKPOINT_SCHEMA=buildurprofile_agent_dev
# Set to 0 for immediate empty responses and the legacy 2-second polling cadence.
AGENT_LEASE_WAIT_MS=20000
# Create a Workers AI API token with Workers AI Read and Edit permissions.
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional fallback: set IMAGE_PROVIDER=openai and provide these values.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08

# PDF resume parsing uses the OpenAI Python SDK with an explicit provider.
# Select one provider and keep its key on the Agent only.
RESUME_TEXT_PROVIDER=openai
RESUME_TEXT_MODEL=gpt-6-luna
OPENAI_API_KEY=
# To use Z.AI/GLM instead, set RESUME_TEXT_PROVIDER=zai and a GLM model name.
# Z.AI Responses supports json_object output; the Agent validates the result.
# RESUME_TEXT_PROVIDER=zai
# RESUME_TEXT_MODEL=glm-5.3
# ZAI_API_KEY=

# Optional fallback chain: comma-separated provider:model entries, tried in order.
# When RESUME_TEXT_FALLBACKS is set it replaces the single provider/model above.
# Candidates whose key variable is missing are skipped at startup.
# RESUME_TEXT_FALLBACKS=siliconflow:deepseek-ai/DeepSeek-V4.1-Flash,siliconflow:Qwen/Qwen3-8B,zai:glm-5.3-flash
# SILICONFLOW_API_KEY=

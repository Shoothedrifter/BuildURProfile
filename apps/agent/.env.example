# Private Python Agent sample. Copy to repository-root .env.agent for the
# development launcher or compose.agent.yml. Merge into existing files.
# Direct Python startup only reads process environment variables, not env files.
# Service token, API URL and checkpoint path are supplied by the launcher/Compose;
# independent deployments must inject them separately (see docs/shared/deployment.md).
# Create a Workers AI API token with Workers AI Read and Edit permissions.
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional fallback: set IMAGE_PROVIDER=openai and provide these values.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08

# P0 PDF resume parsing uses OpenAI structured text output. Keep the key on Agent only.
# Missing settings fail the parse task with PARSE_FAILED.
OPENAI_API_KEY=
RESUME_TEXT_MODEL=gpt-6-luna

# Next.js web-api sample for compose.agent.yml. Copy to repository-root .env.api.
# If .env.api already exists, merge missing settings instead of overwriting it.
# Standalone deployments inject these as process environment variables;
# npm start reads root .env, not .env.api or apps/launcher/.env.
# Keep payment secrets here, never in the Agent environment.
PAYMENT_ENV=sandbox
# Required positive integer price in cents before enabling checkout.
PAYMENT_PRICE_FEN=
# Replace with the actual public HTTPS origin for production.
PUBLIC_BASE_URL=http://127.0.0.1:8787
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PRIVATE_KEY_TYPE=PKCS1
ALIPAY_PUBLIC_KEY=
# At least one seller identity is required for checkout.
ALIPAY_SELLER_ID=
ALIPAY_SELLER_EMAIL=
# Production requires a public HTTPS /api/payment/notify URL without redirects.
ALIPAY_NOTIFY_URL=

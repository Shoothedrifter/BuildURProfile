PAYMENT_ENV=sandbox
# Required service price; choose a positive integer in cents before enabling checkout.
PAYMENT_PRICE_FEN=
PUBLIC_BASE_URL=http://127.0.0.1:5173
# Optional in sandbox when .alipay-sandbox.json has been created by the installed Alipay Skill.
# Never copy sandbox private keys into this file if using that protected JSON file.
# Production app created 2026-10-28 via the Alipay Skill (pending review): 2021007113619286
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PRIVATE_KEY_TYPE=PKCS1
# Production: exported by the Skill to ~/.config/2021007113619286-alipayPublicKey.keytext
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
ALIPAY_SELLER_EMAIL=
# Public HTTPS, no redirect. Leave blank for localhost query-only sandbox recovery.
ALIPAY_NOTIFY_URL=
SERVER_PORT=8787
SERVER_HOST=127.0.0.1
# Optional; defaults to separate sandbox and production SQLite files.
DATABASE_PATH=
# Full-stack generation requires the private Python Agent service. Keep paths
# on persistent private storage together with DATABASE_PATH and data/session-secret.
AVATAR_ASSET_ROOT=
AGENT_CHECKPOINT_PATH=
# Shared private API↔Agent token. npm run dev creates an ephemeral token if blank.
# For separate processes and Docker Compose, generate >=32 random characters.
AGENT_SERVICE_TOKEN=
# Private local Wibi demo only. npm run setup:avatar installs pinned style resources.
# AVATAR_DEMO_ENABLED=1 is accepted only on a loopback API host outside production.
AVATAR_DEMO_ENABLED=0

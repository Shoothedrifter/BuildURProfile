{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResumeParsePlanV1",
  "type": "object",
  "properties": {
    "version": { "const": "resume-parse-plan-v1" },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "anchorId": { "type": "string", "pattern": "^a[0-9]+$", "maxLength": 10 },
          "kind": { "type": "string", "enum": ["basicInfo", "jobIntent", "selfEvaluation", "education", "workExperience", "projects", "awards", "campusExperience", "skills", "other"] },
          "page": { "type": "integer", "minimum": 1, "maximum": 20 },
          "text": { "type": "string", "minLength": 1, "maxLength": 12000 }
        },
        "required": ["anchorId", "kind", "page", "text"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "anchors"],
  "additionalProperties": false
}

{
  "name": "buildurprofile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node apps/launcher/src/dev.mjs",
    "dev:server": "next dev apps/web -H 127.0.0.1 -p 8787",
    "dev:agent": "node scripts/run-python-agent.mjs",
    "setup:avatar": "node scripts/install-wibi-demo.mjs",
    "start": "node apps/launcher/src/index.mjs",
    "test:payment": "node --test apps/launcher/src/*.test.mjs",
    "test:skills": "node --test packages/skills/src/*.test.mjs",
    "test:agent": "node scripts/test-python-agent.mjs && node --test apps/launcher/src/internal-agent.test.mjs apps/launcher/src/generations.test.mjs",
    "test": "vitest run --config vitest.config.ts",
    "build": "tsc --noEmit && next build apps/web --webpack",
    "build:tunnel": "NEXT_PUBLIC_APP_MODE=tunnel tsc --noEmit && NEXT_PUBLIC_APP_MODE=tunnel next build apps/web --webpack"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "alipay-sdk": "^4.14.0",
    "image-size": "^2.0.4",
    "next": "^16.4.5",
    "pdfjs-dist": "^6.4.299",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "urllib": "4.9.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}

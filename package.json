{
  "name": "buildurprofile-showcase-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:export && node apps/api/src/dev.mjs",
    "dev:server": "node apps/api/src/index.mjs",
    "dev:worker": "node apps/worker/src/index.mjs",
    "setup:avatar": "node scripts/install-wibi-demo.mjs",
    "setup:avatar:local": "node scripts/setup-avatar-local.mjs",
    "start": "node apps/api/src/index.mjs",
    "test:payment": "npm run build && node --test apps/api/src/*.test.mjs",
    "test:worker": "node --test apps/worker/src/*.test.mjs",
    "test": "vitest run",
    "build": "tsc --noEmit && npm run build:export && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "build:export": "vite build --config vite.export.config.ts",
    "verify:export": "npm run build:export && node scripts/verify-export.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.5.3",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "alipay-sdk": "^4.14.0",
    "image-size": "^2.0.4",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "urllib": "4.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
